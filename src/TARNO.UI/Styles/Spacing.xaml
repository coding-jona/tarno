<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================
         TARNO Designsystem – Abstands-Tokens (4px-Grid)
         ===================================================== -->

    <x:Double x:Key="Spacing0">0</x:Double>
    <x:Double x:Key="Spacing1">4</x:Double>
    <x:Double x:Key="Spacing2">8</x:Double>
    <x:Double x:Key="Spacing3">12</x:Double>
    <x:Double x:Key="Spacing4">16</x:Double>
    <x:Double x:Key="Spacing5">20</x:Double>
    <x:Double x:Key="Spacing6">24</x:Double>
    <x:Double x:Key="Spacing7">28</x:Double>
    <x:Double x:Key="Spacing8">32</x:Double>
    <x:Double x:Key="Spacing10">40</x:Double>
    <x:Double x:Key="Spacing12">48</x:Double>
    <x:Double x:Key="Spacing16">64</x:Double>

    <!-- Als CornerRadius typisiert (nicht x:Double) — XAML kann Double nicht
         implizit in CornerRadius konvertieren. -->
    <CornerRadius x:Key="CornerRadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusDefault">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusRound">999</CornerRadius>

    <x:Double x:Key="SidebarWidth">64</x:Double>
    <x:Double x:Key="SidebarExpandedWidth">200</x:Double>
    <x:Double x:Key="TopBarHeight">48</x:Double>
    <x:Double x:Key="StatusBarHeight">28</x:Double>

    <!-- Liquid Glass spezifische Größen -->
    <x:Double x:Key="OrbSize">220</x:Double>
    <x:Double x:Key="OrbStageSize">320</x:Double>
    <x:Double x:Key="GlassCardPadding">24</x:Double>
    <x:Double x:Key="GlassCardGap">20</x:Double>
    <x:Double x:Key="GlassFlyoutOffset">18</x:Double>
</ResourceDictionary>
