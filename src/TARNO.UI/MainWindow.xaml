<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TARNO.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TARNO.UI"
    xmlns:controls="using:TARNO.UI.Controls"
    xmlns:comp="using:TARNO.UI.Composition"
    xmlns:models="using:TARNO.UI.Models"
    xmlns:vm="using:TARNO.UI.ViewModels"
    xmlns:services="using:TARNO.UI.Services"
    mc:Ignorable="d">

    <!-- DesktopAcrylicBackdrop statt MicaBackdrop: das ganze Fenster
         scheint zum echten Desktop dahinter durch (WinUI 3 kann das pro
         Element nicht — nur auf Fenster-Ebene, siehe
         docs/liquid-glass-research.md). Vom Nutzer nach Vorschau-Test
         bestätigt (2026-07-13) — abhängig von Windows' eigener
         "Transparenzeffekte"-Einstellung (Einstellungen > Personalisierung
         > Farben); ist die deaktiviert, rendert Windows selbst jeden
         Mica-/Acrylic-Backdrop systemweit blickdicht, unabhängig vom
         App-Code. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- MainCanvasBrush statt BackgroundBaseBrush: deutlich blickdichtere
         Glas-Canvas für den Hauptbereich (Lead-UX-Briefing 2026-07-14) —
         die Sidebar bleibt davon unberührt, da sie ihre eigenen opaken
         Ebenen (SidebarUnderlayerBrush, Blob, LiquidGlassBrush) darüber
         legt. -->
    <Grid
        x:Name="RootGrid"
        Background="{StaticResource MainCanvasBrush}"
        services:DropTargetBehavior.IsDropTarget="True"
        services:DropTargetBehavior.TargetWindowIndex="0">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="D" Modifiers="Control,Shift" Invoked="OnRunLayoutDiagnostics" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="AprilFoolsTitleBarRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Liquid-Glass-Panel. BlobBackground liefert die farbige,
             weiche Fläche hinter dem Glas (ohne sie wäre der Blur unsichtbar),
             AcrylicBrush sorgt für echtes Backdrop-Blur, der diagonale
             Kanten-Verlauf simuliert eine Lichtquelle oben-links, die
             Inset-Highlight-Linie und der zeiger-gekoppelte Specular-Highlight
             ergänzen die Reflexions-/Bewegungs-Prinzipien aus
             docs/liquid-glass-research.md.

             Spalte 0 ist "Auto" statt eines festen Pixelwerts, damit sie der
             animierten Width dieses Grids folgt (SidebarRoot) - ermöglicht
             das smoothe Auf-/Zurollen per Storyboard/DoubleAnimation auf
             Width, siehe OnToggleSidebarClick in MainWindow.xaml.cs. WinUI
             clippt Kind-Inhalte ohnehin automatisch auf die waehrend Arrange
             zugewiesene Groesse, daher reicht die reine Width-Animation. -->
        <Grid x:Name="SidebarRoot" Grid.Row="1" Grid.Column="0" Width="240" HorizontalAlignment="Left" Background="{StaticResource SidebarUnderlayerBrush}">
            <controls:BlobBackground />
            <Border
                Background="{StaticResource LiquidGlassBrush}"
                BorderBrush="{StaticResource LiquidGlassEdgeBrush}"
                BorderThickness="0,0,1,0"
                comp:SpecularHighlightBehavior.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Inset-Highlight-Linie: dünner heller Strich an der
                     Oberkante, entspricht "inset 0 1px 0 rgba(255,255,255,.35)". -->
                <Border
                    Grid.Row="0"
                    Grid.RowSpan="5"
                    BorderBrush="{StaticResource LiquidGlassInsetHighlightBrush}"
                    BorderThickness="0,1,0,0"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False" />

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,18,20,12" Spacing="12">
                    <Grid Width="36" Height="36">
                        <Ellipse Fill="{StaticResource AccentPrimaryBrush}" Opacity="0.18" />
                        <TextBlock
                            Text="&#xE756;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{StaticResource TextAccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            x:Uid="MainWindow_BrandTitle"
                            Text="TARNO"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            x:Uid="MainWindow_BrandSubtitle"
                            Text="Voice Assistant"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Chat / Code Modus-Switch -->
                <StackPanel Grid.Row="1" Margin="12,0,12,12" Spacing="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button
                        x:Name="ModeChatButton"
                        Click="OnModeChatClick"
                        Style="{StaticResource NavItemStyle}"
                        Padding="12,6"
                        HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="&#xE8BD;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16" />
                            <TextBlock x:Uid="MainWindow_ChatMode" Text="Chat" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ModeCodeButton"
                        Click="OnModeCodeClick"
                        Style="{StaticResource NavItemStyle}"
                        Padding="12,6"
                        HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="&#xE943;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16" />
                            <TextBlock x:Uid="MainWindow_CodeMode" Text="Code" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Standard-Navigation (Chat-Modus). In einem ScrollViewer,
                     damit zusaetzliche Nav-Punkte (z.B. "Mesh-Geräte") bei
                     kleineren Fensterhoehen nicht abgeschnitten werden,
                     sondern scrollbar sind - vorher lief die Liste einfach
                     unten aus dem sichtbaren Bereich raus. -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible" x:Name="StandardNavScrollViewer">
                <StackPanel x:Name="StandardNavPanel" Margin="12,0,12,0" Spacing="4">
                    <Button
                        x:Name="NavHome"
                        Tag="Home"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE80F;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_HomeNav" Text="Dashboard" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavVoice"
                        Tag="Voice"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE720;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_VoiceNav" Text="Voice" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavChat"
                        Tag="Chat"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE8BD;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_ChatNav" Text="Chat" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavTasks"
                        Tag="Tasks"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE9D5;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_TasksNav" Text="Tasks" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavMemory"
                        Tag="Memory"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE8D4;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_MemoryNav" Text="Memory" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavSettings"
                        Tag="Settings"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE713;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_SettingsNav" Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavApiKeys"
                        Tag="ApiKeys"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE72E;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_ApiKeysNav" Text="API-Keys" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavLogs"
                        Tag="Logs"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE8A5;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_LogsNav" Text="Logs" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavMeshDevices"
                        Tag="MeshDevices"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE839;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_MeshDevicesNav" Text="Mesh-Geräte" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavMeshDashboard"
                        Tag="MeshDashboard"
                        Click="OnNavClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE9D9;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_MeshDashboardNav" Text="Mesh-Dashboard" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>

                <!-- Workspace-Navigation (Code-Modus). Bewusst NICHT in einen
                     ScrollViewer gewickelt (anders als StandardNavPanel oben) -
                     die ListView hier hat schon eigenes Scrolling, ein
                     zusaetzlicher aeusserer ScrollViewer wuerde damit
                     kollidieren. Unveraendert gegenueber vorher. -->
                <StackPanel x:Name="WorkspaceNavPanel" Grid.Row="2" Margin="12,0,12,0" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Uid="MainWindow_WorkspacesNav" Text="Workspaces" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,4" />
                    <ListView
                        x:Name="WorkspaceListView"
                        ItemsSource="{x:Bind ViewModel.Workspaces, Mode=OneWay}"
                        SelectionChanged="OnWorkspaceSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Workspace">
                                <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        x:Name="ManageWorkspacesButton"
                        Click="OnManageWorkspacesClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE713;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_ManageWorkspaces" Text="Workspaces verwalten" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Chat-Sessions: immer sichtbar, unabhängig vom Chat/Code-Modus -->
                <Grid Grid.Row="3" Margin="12,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="NewChatButton"
                        Grid.Row="0"
                        Click="OnNewChatClick"
                        Style="{StaticResource NavItemStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="&#xE710;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" />
                            <TextBlock x:Uid="MainWindow_NewChat" Text="Neuer Chat" />
                        </StackPanel>
                    </Button>
                    <ListView
                        x:Name="ChatSessionsListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.FilteredChatSessions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedChatSession, Mode=TwoWay}"
                        SelectionChanged="OnChatSessionSelectionChanged"
                        SelectionMode="Single"
                        MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatSessionViewModel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle, Mode=OneWay}"
                                            FontSize="10"
                                            Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="&#xE74D;"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="12"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnDeleteChatClick"
                                        Tag="{x:Bind Id}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="4" Margin="20,12,20,16" Spacing="8">
                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource GlassComboBoxStyle}" SelectionChanged="OnLanguageChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Uid="MainWindow_LanguageGerman" Content="Deutsch" Tag="de" />
                        <ComboBoxItem x:Uid="MainWindow_LanguageEnglish" Content="English" Tag="en" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                        FontSize="10"
                        Foreground="{StaticResource TextMutedBrush}"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            </Border>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Eigene, gedimmte Blob-Ebene für den Hauptbereich: die
                 Sidebar wirkt lebendig, weil sie eine eigene Farbschicht
                 hat, die nicht vom Desktop-Passthrough abhängt. Ohne diese
                 Ebene wirkt der Hauptbereich flach, sobald zufällig nichts
                 Farbiges hinter dem Fenster liegt (siehe Design-Review
                 2026-07-14). Gedimmt (Opacity 0.5) und hinter allem
                 anderen, damit Text/Karten weiter gut lesbar bleiben. -->
            <controls:BlobBackground Grid.RowSpan="2" Opacity="0.5" />

            <!-- TitleBar: MainCanvasBrush statt Hardcoded-Hex, konsistent mit
                 dem restlichen Hauptbereich. -->
            <Border
                x:Name="DefaultTitleBar"
                x:FieldModifier="public"
                Grid.Row="0"
                Height="58"
                Background="{StaticResource MainCanvasBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <!-- Hardware-/OS-Info bewusst nicht mehr hier gezeigt (lenkt ab,
                     gehört nicht in den Haupt-Header — siehe Design-Review
                     2026-07-14). ViewModel.SystemInfo bleibt bestehen für eine
                     spätere "Über TARNO"-Sektion in den Einstellungen. -->
                <Grid Margin="20,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <!-- Bewusst hier statt in der Sidebar selbst platziert:
                             so bleibt der Button immer an derselben Stelle
                             klickbar, auch wenn SidebarRoot auf Width=0
                             zugerollt ist. -->
                        <Button
                            x:Name="SidebarToggleButton"
                            Click="OnToggleSidebarClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            ToolTipService.ToolTip="Seitenleiste ein-/ausblenden">
                            <TextBlock
                                Text="&#xE700;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedPage, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content frame: transparent statt BackgroundBaseBrush. Die
                 einzelnen Seiten setzen zusätzlich noch ihre eigene
                 Background auf dem Root-Element — Rollout Seite für Seite,
                 siehe jeweilige .xaml-Datei. -->
            <Frame
                x:Name="ContentFrame"
                x:FieldModifier="public"
                Grid.Row="1"
                Background="Transparent"
                Navigated="OnContentFrameNavigated" />
        </Grid>

        <!-- April-Fools-Titlebar: nur im April-Fools-Modus sichtbar.
             Statt der OS-Titlebar wird eine eigene, verschiebbare Leiste gerendert. -->
        <Border
            x:Name="AprilFoolsTitleBar"
            x:FieldModifier="public"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Height="46"
            Background="{StaticResource MainCanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed"
            IsHitTestVisible="True">
            <Grid Margin="20,0,20,0">
                <TextBlock
                    Text="TARNO"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- April-Fools-Overlay: Canvas ohne Hintergrund, damit Klicks
             durchgeleitet werden. Enthält den bewegbaren X-Button und Fakes. -->
        <Canvas
            x:Name="AprilFoolsOverlay"
            x:FieldModifier="public"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Visibility="Collapsed">
            <Button
                x:Name="AprilFoolsCloseButton"
                x:FieldModifier="public"
                Content="X"
                Width="46"
                Height="46"
                FontSize="16"
                FontWeight="SemiBold"
                Background="Red"
                Foreground="White"
                BorderThickness="0"
                Canvas.Top="0"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Versuch's gar nicht erst, Digger." />
        </Canvas>
    </Grid>
</Window>
