{
  "name": "TARNO WinUI Design Tokens",
  "version": "1.0.0",
  "theme": "dark",
  "accent": "#0BC7FF",
  "colors": {
    "black": "#000000",
    "neutral-1000": "#0A0C14",
    "neutral-900": "#111111",
    "neutral-800": "#181A27",
    "neutral-700": "#1A1D2E",
    "neutral-600": "#222222",
    "neutral-500": "#333333",
    "neutral-400": "#444444",
    "neutral-300": "#555555",
    "neutral-200": "#8890A4",
    "neutral-100": "#B0B8C8",
    "neutral-50": "#EEEEEE",
    "white": "#FFFFFF",
    "cyan-500": "#0BC7FF",
    "cyan-400": "#33D1FF",
    "cyan-300": "#66DDFF",
    "cyan-600": "#0099CC",
    "cyan-700": "#0077A3",
    "turquoise-500": "#2DD4BF",
    "orange-500": "#F59E0B",
    "red-500": "#FF4444",
    "purple-500": "#7C5CBF"
  },
  "semantic": {
    "background-base": "neutral-900",
    "background-subtle": "neutral-800",
    "background-sidebar": "neutral-1000",
    "background-card": "neutral-700",
    "background-input": "neutral-600",
    "background-hover": "neutral-500",
    "background-pressed": "neutral-400",
    "text-primary": "neutral-50",
    "text-secondary": "neutral-200",
    "text-muted": "neutral-300",
    "text-accent": "cyan-500",
    "accent-primary": "cyan-500",
    "accent-hover": "cyan-400",
    "accent-pressed": "cyan-600",
    "success": "turquoise-500",
    "warning": "orange-500",
    "error": "red-500",
    "border": "neutral-500",
    "border-focus": "cyan-500"
  },
  "typography": {
    "font-family": "Segoe UI Variable, Segoe UI, sans-serif",
    "font-family-mono": "Cascadia Mono, Consolas, monospace",
    "sizes": {
      "hero": 32,
      "h1": 24,
      "h2": 20,
      "h3": 16,
      "body": 14,
      "small": 12,
      "tiny": 10
    }
  },
  "spacing": {
    "grid": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 64]
  },
  "radius": {
    "small": 2,
    "default": 4,
    "medium": 8,
    "large": 12,
    "round": 999
  },
  "shadows": {
    "elevation-1": {
      "offset": "0,2",
      "blur": 4,
      "opacity": 0.14,
      "color": "#000000"
    },
    "elevation-2": {
      "offset": "0,4",
      "blur": 8,
      "opacity": 0.18,
      "color": "#000000"
    },
    "elevation-3": {
      "offset": "0,8",
      "blur": 16,
      "opacity": 0.22,
      "color": "#000000"
    }
  }
}
