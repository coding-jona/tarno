<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TARNO.UI.Pages.VoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,0" Spacing="4">
            <TextBlock
                Text="Voice"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock
                Text="Aktiviere das Mikrofon, um mit TARNO zu sprechen."
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Spacing="20">
                <!-- Nativer Composition-Orb (kein WebView2 mehr): WinUI 3s WebView2
                     kann in keinem der vier versuchten Verfahren (Property, XAML,
                     CSS, ThemeDictionary-Override - alle pixelverifiziert) echte
                     Transparenz/Farb-Matching herstellen, siehe
                     microsoft/microsoft-ui-xaml#6527. OrbVisualController haengt
                     SpriteVisuals direkt in den XAML-Baum (gleiches Muster wie
                     SpecularHighlightBehavior) - kein Sub-Prozess-Hosting, daher
                     keine Boxen/Transparenzluecke moeglich. -->
                <Grid x:Name="OrbRoot" Width="440" Height="440" HorizontalAlignment="Center" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="OrbScaleTransform" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid
                        x:Name="OrbGlowHost"
                        Width="300"
                        Height="300"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent" />

                    <Ellipse
                        x:Name="OrbRim"
                        Width="242"
                        Height="242"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        StrokeThickness="1.4"
                        Fill="Transparent">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0.0" Color="#0DFFFFFF" />
                                <GradientStop Offset="0.5" Color="#66FFFFFF" />
                                <GradientStop Offset="1.0" Color="#0DFFFFFF" />
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                    </Ellipse>

                    <Border
                        Width="240"
                        Height="240"
                        CornerRadius="120"
                        Background="{StaticResource LiquidGlassBrush}"
                        BorderBrush="#0DFFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                    <Grid
                        x:Name="OrbCoreHost"
                        Width="170"
                        Height="170"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent" />

                    <ToggleButton
                        x:Name="MicToggle"
                        Width="240"
                        Height="240"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource TARNOPrimaryToggleButtonStyle}"
                        CornerRadius="120"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="OnMicToggleClick" />
                </Grid>

                <TextBlock
                    x:Name="MicToggleLabel"
                    Text="Mikrofon aktivieren"
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    HorizontalAlignment="Center" />

                <StackPanel x:Name="MuteStatusPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock
                        Text="&#xE74F;"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Foreground="#FF5F5F"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="MuteStatusText"
                        Text="Gemutet"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FF5F5F"
                        VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock
                    x:Name="HintText"
                    Text="Sagen Sie 'Hey Tarno' oder klicken Sie auf den Button."
                    Style="{StaticResource SecondaryTextBlockStyle}"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
