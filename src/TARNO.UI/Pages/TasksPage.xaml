<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TARNO.UI.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TARNO.UI.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock Text="Tasks" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Geplante und laufende Aufgaben." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}">
            <ListView ItemsSource="{x:Bind ViewModel.Tasks}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskViewModel">
                        <Grid Padding="0,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Status}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
