<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TARNO.UI.Pages.MeshDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28" Spacing="6">
            <TextBlock Text="Mesh-Dashboard" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Live-Uebersicht aller Tracking-Daten pro Geraet - Akku, Standort, App-Nutzung gleichzeitig, nicht nur der letzte Sync." FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center">
            <StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Center">

                <!-- Nicht eingeloggt -->
                <Border x:Name="NotLoggedInCard" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                    <TextBlock Text="Nicht eingeloggt - bitte zuerst auf der Mesh-Geraete-Seite anmelden." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>

                <!-- Uebersichtskacheln -->
                <Grid x:Name="SummaryGrid" ColumnSpacing="16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Geraete gesamt" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TotalCountText" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Online" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="OnlineCountText" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Offline" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="OfflineCountText" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="EmptyText" Text="Noch keine Geraete registriert - siehe Mesh-Geraete-Seite." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed" />

                <!-- Pro-Geraet-Karten -->
                <ItemsControl x:Name="DeviceCardsPanel" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
