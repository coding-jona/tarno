<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TARNO.UI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:TARNO.UI.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <conv:VoiceStateToLabelConverter x:Key="VoiceStateToLabelConverter" />
    </Page.Resources>

    <ScrollViewer Padding="40,32" HorizontalContentAlignment="Center">
        <StackPanel Spacing="32" MaxWidth="1160" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock Text="Willkommen zurück" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Dein persönlicher Voice Assistant ist bereit." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Status" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Verbindung" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextAccentBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Voice" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.VoiceState, Mode=OneWay, Converter={StaticResource VoiceStateToLabelConverter}}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Voice-Modus" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Sprich mit TARNO über das Mikrofon." FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Content="Voice öffnen" Click="OpenVoice" Style="{StaticResource GlassPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Chat" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Schreibe mit TARNO wie mit einem Assistenten." FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Content="Chat öffnen" Click="OpenChat" Style="{StaticResource GlassSecondaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Funktionen" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Spracherkennung mit Wake-Word 'Hey Tarno'" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE839;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Lokale KI-Anbindung über Ollama / gRPC" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE767;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Deutsche Sprachausgabe mit edge-tts" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="&#xE821;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Memory-Modul für Kontext und Fakten" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
