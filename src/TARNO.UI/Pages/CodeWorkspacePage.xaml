<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ctrl="using:TARNO.UI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="using:TARNO.UI.UserControls" xmlns:sizers="using:CommunityToolkit.WinUI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TARNO.UI.Pages.CodeWorkspacePage" mc:Ignorable="d" Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="OnCommandPaletteAccelerator" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="260" MinWidth="180" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{StaticResource MainCanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="40" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Explorer" VerticalAlignment="Center" Margin="16,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
            <TreeView x:Name="ExplorerTree" Grid.Row="1" ItemInvoked="OnTreeItemInvoked" Expanding="OnTreeExpanding" Collapsed="OnTreeCollapsed" Margin="8,0,0,0">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Zum Kontext hinzufügen" Click="OnAddToContextClick" />
                        <MenuFlyoutItem Text="Im Explorer öffnen" Click="OnOpenInFileExplorerClick" />
                        <MenuFlyoutItem Text="Pfad kopieren" Click="OnCopyPathClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Ordner hinzufügen" Click="OnAddFolderToWorkspaceClick" />
                        <MenuFlyoutItem Text="Root entfernen" Click="OnRemoveRootClick" />
                    </MenuFlyout>
                </TreeView.ContextFlyout>
            </TreeView>
            <TextBox x:Name="FileContentView" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" PlaceholderText="Dateiinhalt" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" />
        </Grid>
        <sizers:GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Grid x:Name="RightGrid" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border x:Name="ChatPanelBorder" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Height="32" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Chat" VerticalAlignment="Center" Margin="12,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <uc:ChatView x:Name="WorkspaceChatView" Grid.Row="1" />
                </Grid>
            </Border>
            <Border x:Name="CodingPanelBorder" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Background="{StaticResource MainCanvasBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Height="32" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Coding-Agent" VerticalAlignment="Center" Margin="12,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button x:Name="CodingToggleButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Padding="6,2" Background="Transparent" BorderThickness="0" Click="OnCodingPanelToggleClick" Foreground="{StaticResource TextSecondaryBrush}" Content="▶" />
                        </Grid>
                    </Border>
                    <Grid x:Name="CodingContent" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource MainCanvasBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="CodingOutput" Grid.Row="0" ItemsSource="{x:Bind ViewModel.CodingOutputs, Mode=OneWay}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Grid Grid.Row="1" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CodingInput" Grid.Column="0" PlaceholderText="Coding-Aufgabe eingeben..." KeyDown="OnCodingInputKeyDown" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" />
                            <CheckBox x:Name="ReadOnlyCheck" Grid.Column="1" Content="Nur lesen" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button x:Name="SendCodingTaskButton" Grid.Column="2" Content="Senden" Click="OnSendCodingTaskClick" Margin="8,0,8,0" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="TerminalPanelBorder" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid x:Name="TerminalRoot" Background="{StaticResource MainCanvasBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Height="32" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Terminal" VerticalAlignment="Center" Margin="12,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <ListView x:Name="TerminalOutput" Grid.Row="1" ItemsSource="{x:Bind Terminal.OutputLines, Mode=OneWay}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <TextBox x:Name="TerminalInput" Grid.Row="2" PlaceholderText="Befehl eingeben..." KeyDown="OnTerminalInputKeyDown" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" />
                </Grid>
            </Border>
        </Grid>
        <sizers:GridSplitter Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="BasedOnAlignment" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Grid x:Name="ContextDock" Grid.Column="4" Background="{StaticResource MainCanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="40" Background="{StaticResource MainCanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Kontext" VerticalAlignment="Center" Margin="16,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="12" Spacing="12">
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Layout" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button Content="Gestapelt (gleich groß)" Click="OnEqualStackedClick" HorizontalAlignment="Stretch" Style="{StaticResource GlassSecondaryButtonStyle}" />
                            <Button Content="Nebeneinander (gleich groß)" Click="OnEqualSideBySideClick" HorizontalAlignment="Stretch" Style="{StaticResource GlassSecondaryButtonStyle}" />
                            <TextBlock Text="Großes Panel" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            <ComboBox x:Name="PrimaryPanelCombo" HorizontalAlignment="Stretch" SelectionChanged="OnFocusLayoutComboChanged">
                                <ComboBoxItem Content="Chat" Tag="Chat" />
                                <ComboBoxItem Content="Coding" Tag="Coding" />
                                <ComboBoxItem Content="Terminal" Tag="Terminal" />
                            </ComboBox>
                            <TextBlock Text="Position des großen Panels" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="AnchorCombo" HorizontalAlignment="Stretch" SelectionChanged="OnFocusLayoutComboChanged">
                                <ComboBoxItem Content="Links" Tag="Left" />
                                <ComboBoxItem Content="Rechts" Tag="Right" />
                                <ComboBoxItem Content="Oben" Tag="Top" />
                                <ComboBoxItem Content="Unten" Tag="Bottom" />
                            </ComboBox>
                            <TextBlock Text="Reihenfolge der anderen zwei" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="SecondaryOrderCombo" HorizontalAlignment="Stretch" SelectionChanged="OnFocusLayoutComboChanged">
                                <ComboBoxItem Content="Normal" Tag="Normal" />
                                <ComboBoxItem Content="Vertauscht" Tag="Swapped" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Markierte Dateien" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ListView ItemsSource="{x:Bind ViewModel.SelectedContextFiles, Mode=OneWay}" MaxHeight="160" BorderThickness="0" Background="Transparent">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Kontext leeren" HorizontalAlignment="Stretch" Click="OnClearContextFilesClick" Style="{StaticResource GlassSecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Quick Actions" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button Content="Build" Style="{StaticResource GlassSecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                            <Button Content="Testen" Style="{StaticResource GlassSecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                            <Button Content="Git-Status" Style="{StaticResource GlassSecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                            <Button Content="Befehlspalette" Click="OnOpenCommandPaletteClick" Style="{StaticResource GlassSecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Provider / Modell" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveProviderModelLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Agent-Status" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Bereit" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
