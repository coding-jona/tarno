<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TARNO.UI.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TARNO.UI.ViewModels"
    xmlns:conv="using:TARNO.UI.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,24,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Chat" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Phase D: Modell-/Provider-Selektor - Flyout wie der
                 Autonomie-Modus-Umschalter in der Eingabezeile. ActiveProvider
                 kommt ausschliesslich aus dem Server-Echo. -->
            <Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Margin="0,0,10,0"
                Padding="10,6"
                Background="Transparent"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                Click="OnCodingActionModeClick"
                ToolTipService.ToolTip="Coding-Agent Aktion-Modus: Plan / Manual / Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🤖" FontSize="12" />
                    <TextBlock
                        Text="{x:Bind ViewModel.CodingActionMode, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Plan — nur Vorschläge" Click="OnActionModePlan" />
                        <MenuFlyoutItem Text="Manual — immer fragen" Click="OnActionModeManual" />
                        <MenuFlyoutItem Text="Auto — Workspace sofort ausführen" Click="OnActionModeAuto" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button
                Grid.Column="2"
                VerticalAlignment="Top"
                Margin="0,0,10,0"
                Padding="10,6"
                Background="Transparent"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                ToolTipService.ToolTip="Aktiver LLM-Provider und Modell: klicken zum Wechseln">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⚙" FontSize="12" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ActiveProviderModelLabel, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <Button.Flyout>
                    <!-- Phase 1-6: zweistufiger Picker - Klick auf den Provider-
                         Eintrag waehlt dessen Standardmodell, das Untermenue
                         (dynamisch aus ViewModel.ModelCatalog befuellt in
                         OnProviderFlyoutOpening) zeigt die kuratierten Modelle
                         mit Rate-Limit-Schaetzung und Faehigkeits-Stichworten. -->
                    <MenuFlyout Placement="Bottom" Opening="OnProviderFlyoutOpening">
                        <MenuFlyoutSubItem x:Name="MistralModelsSubItem" Text="Mistral" />
                        <MenuFlyoutSubItem x:Name="OpenAIModelsSubItem" Text="OpenAI" />
                        <MenuFlyoutSubItem x:Name="ClaudeModelsSubItem" Text="Claude (Anthropic)" />
                        <MenuFlyoutSubItem x:Name="GeminiModelsSubItem" Text="Gemini" />
                        <MenuFlyoutSubItem x:Name="GroqModelsSubItem" Text="Groq" />
                        <MenuFlyoutSubItem x:Name="HuggingFaceModelsSubItem" Text="Hugging Face" />
                        <MenuFlyoutSubItem x:Name="GlmModelsSubItem" Text="GLM" />
                        <MenuFlyoutSubItem x:Name="PerplexityModelsSubItem" Text="Perplexity" />
                        <MenuFlyoutSubItem x:Name="MetaModelsSubItem" Text="Meta" />
                        <MenuFlyoutSubItem x:Name="DeepSeekModelsSubItem" Text="DeepSeek" />
                        <MenuFlyoutSubItem x:Name="MoonshotModelsSubItem" Text="Moonshot (Kimi)" />
                        <MenuFlyoutSubItem x:Name="QwenModelsSubItem" Text="Qwen" />
                        <MenuFlyoutSubItem x:Name="OpenRouterModelsSubItem" Text="OpenRouter" />
                        <MenuFlyoutSubItem x:Name="OllamaModelsSubItem" Text="Ollama (lokal)" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Phase C: "Denk-Modus"-Umschalter - fordert aktiv strukturierten
                 Denk-Inhalt an (mehr Tokens/Latenz), im Unterschied zum
                 kostenlosen <think>-Capture, das immer laeuft. Schlichter
                 Toggle, kein Flyout - anders als der Autonomie-Modus gibt es
                 hier nur an/aus. -->
            <Button
                Grid.Column="3"
                VerticalAlignment="Top"
                Margin="0,0,10,0"
                Padding="10,6"
                Background="Transparent"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                Click="OnReasoningToggleClick"
                ToolTipService.ToolTip="Denk-Modus: fordert ausführlicheres Nachdenken an (mehr Latenz)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🧠" FontSize="12" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ReasoningModeEnabled, Mode=OneWay, Converter={StaticResource BoolToOnOffLabelConverter}}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>

            <!-- Manueller "Starkes Modell"-Schalter (mistral-medium-2508) -
                 ersetzt die vormals automatische, fehleranfaellige
                 Klassifizierung (siehe MistralProvider._classify_difficulty).
                 Nur bei Mistral sinnvoll, Server ignoriert es bei anderen
                 Providern ohnehin still. -->
            <Button
                Grid.Column="4"
                VerticalAlignment="Top"
                Margin="0,0,10,0"
                Padding="10,6"
                Background="Transparent"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                Click="OnHighTierToggleClick"
                ToolTipService.ToolTip="Starkes Modell (mistral-medium-2508): höhere Qualität bei komplexen Anfragen — deutlich langsamer (~0,38 Anfragen/Sekunde) und höherer Tokenverbrauch. Nur bei Mistral wirksam.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="💪" FontSize="12" />
                    <TextBlock
                        Text="{x:Bind ViewModel.HighTierModelEnabled, Mode=OneWay, Converter={StaticResource BoolToOnOffLabelConverter}}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>

            <!-- Block 7, Phase 69: Kamera-Status-Indikator + Opt-out. Bewusst
                 immer sichtbar (nicht nur wenn aktiv), damit der Nutzer jederzeit
                 sehen und umschalten kann, ob TARNOs Kamera-Vision läuft. -->
            <Button
                Grid.Column="5"
                VerticalAlignment="Top"
                Padding="10,6"
                Background="Transparent"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                Click="OnVisionToggleClick"
                ToolTipService.ToolTip="Kamera-Vision: klicken zum Umschalten">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse
                        Width="8" Height="8" VerticalAlignment="Center"
                        Fill="{x:Bind ViewModel.VisionCameraActive, Mode=OneWay, Converter={StaticResource VisionStatusToBrushConverter}}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.VisionCameraActive, Mode=OneWay, Converter={StaticResource BoolToVisionLabelConverter}}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>

            <!-- Buendelt die seltener gebrauchten Toggles (Starkes Modell,
                 Kontext-Effizienz, Agent-Pool) in einem Dialog - reaktiviert
                 ChatSettingsDialog, das zuvor gebaut, aber nie an einen Button
                 angeschlossen war. Starkes-Modell-Button oben bleibt zusaetzlich
                 als Schnellzugriff bestehen (siehe ChatSettingsDialog-Kommentar). -->
            <Button
                Grid.Column="6"
                VerticalAlignment="Top"
                Padding="10,6"
                Background="Transparent"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                Click="OnOpenChatSettingsClick"
                ToolTipService.ToolTip="Weitere Einstellungen: Kontext-Effizienz, Agent-Pool">
                <TextBlock Text="⚙️" FontSize="14" />
            </Button>
        </Grid>

        <Grid
            x:Name="MessagesRoot"
            Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="MessagesListView"
                Grid.Column="0"
                Padding="24,16"
                SelectionMode="None"
                IsItemClickEnabled="False"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ItemsSource="{x:Bind ViewModel.Messages}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,4" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                        <Border
                            MaxWidth="560"
                            Padding="20,16"
                            CornerRadius="{StaticResource CornerRadiusLarge}"
                            Background="{x:Bind Role, Converter={StaticResource RoleToBrushConverter}}"
                            BorderBrush="{x:Bind Role, Converter={StaticResource RoleToBorderBrushConverter}}"
                            BorderThickness="1"
                            HorizontalAlignment="{x:Bind Role, Converter={StaticResource RoleToAlignmentConverter}}">
                            <StackPanel Spacing="6">
                                <RichTextBlock
                                    conv:MarkdownTextBehavior.Markdown="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Foreground="{StaticResource TextPrimaryBrush}" />
                                <Image
                                    Source="{x:Bind ImageSource, Mode=OneWay}"
                                    MaxHeight="240"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind ImageSource, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                    ToolTipService.ToolTip="{x:Bind ImageCaption, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind Timestamp}"
                                    FontSize="10"
                                    Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="TracePanel"
                Grid.Column="1"
                Width="320"
                Margin="0,16,24,16"
                Padding="12"
                Background="{StaticResource SurfaceGlassBrush}"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="Thought Stream"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Margin="0,0,0,8" />
                    <ListView
                        x:Name="TraceListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.TraceItems, Mode=OneWay}"
                        SelectionMode="None"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AgentTraceViewModel">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Icon}" FontSize="12" />
                                        <TextBlock
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Visibility="{x:Bind Title, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <TextBlock
                                            Text="{x:Bind Target, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Visibility="{x:Bind Target, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind Description, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind Description, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                                    <Border
                                        Background="{StaticResource SurfaceDarkBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource GlassEdgeHiBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSmall}"
                                        Padding="8"
                                        Visibility="{x:Bind Content, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock
                                            Text="{x:Bind Content, Mode=OneWay}"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Echte "Denkt nach..."-Anzeige: zeigt den tatsächlich laufenden
             Pipeline-Schritt (LLM-Call/Tool-Ausführung/Folge-Antwort) bzw.
             einen erfassten <think>-Reasoning-Block, statt eines statischen
             Platzhalters. Geschwister-Element der ListView in derselben
             Zeile, unten ausgerichtet, damit kein neues Grid-Row nötig ist. -->
        <TextBlock
            Grid.Row="1"
            Text="{x:Bind ViewModel.ThinkingState.Message, Mode=OneWay}"
            FontStyle="Italic"
            Foreground="{StaticResource TextSecondaryBrush}"
            Margin="40,0,24,8"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ThinkingState.IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Voice-/Status-Orb (compact): schwebendes Overlay über der
             Nachrichtenliste (Geschwister-Element der ListView, ebenfalls
             Grid.Row="1") statt einer eigenen Grid-Row - die ListView nutzt
             so die volle verfügbare Höhe, statt vom Orb verkürzt zu werden.
             IsHitTestVisible=False, damit Scrollen/Klicks auf Nachrichten
             darunter nicht blockiert werden - der Orb ist reiner Statusanzeiger,
             kein Klick-Ziel (das bleibt VoicePages größerem Orb vorbehalten). -->
        <Grid
            x:Name="OrbRoot"
            Grid.Row="1"
            Width="220" Height="220"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,70"
            Background="Transparent"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,0.5">
            <!-- Ganzkoerper-Sprech-Resonanz skaliert GENAU diesen RenderTransform
                 (ueber XAML/Storyboard, nicht ueber Composition-Visual-Scale -
                 Composition-Scale auf einem ueber ElementCompositionPreview
                 geholten Visual eines plain XAML-Grids hat sich live als nicht
                 renderend erwiesen, selbst bei einer uebertriebenen 150%-
                 Testanimation). RenderTransform auf einem Panel transformiert
                 IMMER das gesamte Subtree als starren Koerper (Glow+Ring+Glas+
                 Core zusammen), unabhaengig von JEDER inneren Animation
                 (Glow-Farbe/-Opacity, Core-Atmen, Ring-Rotation laufen normal
                 weiter) - exakt das vom Nutzer geforderte Verhalten
                 ("Resonanzkugel wie in Musikvideos"). -->
            <Grid.RenderTransform>
                <ScaleTransform x:Name="OrbScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <!-- Glow-Host bewusst deutlich größer als der sichtbare Ring
                 (90px) - gibt dem radialen, zur Transparenz auslaufenden
                 Glow-Brush mehr Raum, um wie im Referenz-Mockup sichtbar
                 über den Rand des Rings hinauszubluten, statt hart am
                 Host-Rand abgeschnitten zu werden (SpriteVisual kann seinen
                 Host nicht überschreiten - der Host selbst muss also größer
                 sein als die sichtbare Ring-Chrome). -->
            <Grid
                x:Name="OrbGlowHost"
                Width="160"
                Height="160"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent" />

            <Ellipse
                x:Name="OrbRim"
                Width="90"
                Height="90"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                StrokeThickness="1.2"
                Fill="Transparent">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0.0" Color="#0DFFFFFF" />
                        <GradientStop Offset="0.5" Color="#66FFFFFF" />
                        <GradientStop Offset="1.0" Color="#0DFFFFFF" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <Border
                Width="88"
                Height="88"
                CornerRadius="44"
                Background="{StaticResource LiquidGlassBrush}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <Grid
                x:Name="OrbCoreHost"
                Width="64"
                Height="64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent" />

        </Grid>

        <!-- Anhang-Chip: zeigt das per Datei-Picker ausgewählte, noch nicht
             gesendete Bild mit Dateiname und "x"-Entfernen-Button. Row 2 war
             bisher ungenutzt (Header=0, Messages/Orb=1, Input=3). -->
        <Border
            Grid.Row="2"
            Background="{StaticResource SurfaceGlassBrush}"
            BorderBrush="{StaticResource GlassEdgeHiBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Margin="24,0,24,8"
            Padding="8,6"
            MaxWidth="960"
            HorizontalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasPendingAttachment, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image
                    Source="{x:Bind ViewModel.PendingAttachmentPreview, Mode=OneWay}"
                    Width="32" Height="32"
                    Stretch="UniformToFill" />
                <TextBlock
                    Text="{x:Bind ViewModel.PendingAttachmentFilename, Mode=OneWay}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}" />
                <Button
                    Padding="6,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="✕"
                    Click="OnRemoveAttachmentClick"
                    ToolTipService.ToolTip="Anhang entfernen" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Background="{StaticResource SurfaceGlassBrush}"
            BorderBrush="{StaticResource GlassEdgeHiBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Margin="24,0,24,20"
            Padding="16,12"
            MaxWidth="960"
            HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Autonomie-Modus-Umschalter: steuert, wie viel TARNO ohne
                     Rückfrage ausführen darf (Manuell/Automatisch/Plan/Ultimate).
                     Entspricht AutonomyMode im Python-Backend. -->
                <Button
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="10,6"
                    Background="Transparent"
                    BorderBrush="{x:Bind ViewModel.AutonomyMode, Mode=OneWay, Converter={StaticResource AutonomyModeToBrushConverter}}"
                    BorderThickness="1.2"
                    CornerRadius="{StaticResource CornerRadiusLarge}"
                    ToolTipService.ToolTip="Autonomie-Modus: steuert, wie viel TARNO ohne Rückfrage ausführt">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="8" Height="8" VerticalAlignment="Center"
                            Fill="{x:Bind ViewModel.AutonomyMode, Mode=OneWay, Converter={StaticResource AutonomyModeToBrushConverter}}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.AutonomyMode, Mode=OneWay, Converter={StaticResource AutonomyModeToLabelConverter}}"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Top">
                            <MenuFlyoutItem Text="Manuell — immer fragen" Click="OnAutonomyModeManual" />
                            <MenuFlyoutItem Text="Automatisch — Medium ohne Rückfrage, Ansage" Click="OnAutonomyModeBalanced" />
                            <MenuFlyoutItem Text="Plan — nur Vorschau, nichts wird ausgeführt" Click="OnAutonomyModePlan" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Ultimate — auch High-Risiko ohne Rückfrage" Click="OnAutonomyModeUltimate" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Kontextfenster-Nutzung: gefüllter Ring wie bei ChatGPT/Claude.
                     Basiert auf echten Token-Zahlen aus der Mistral-API-Antwort
                     (usage.total_tokens), nicht geschätzt. 0% bis zur ersten Antwort. -->
                <Grid
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    Margin="0,0,12,0"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ContextUsedTokens, Mode=OneWay}">
                    <ProgressRing
                        IsIndeterminate="False"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.ContextUsagePercent, Mode=OneWay}"
                        Foreground="{StaticResource AccentPrimaryBrush}" />
                </Grid>

                <!-- Datei-/Bild-Upload (Phase A): öffnet den Windows-Datei-Picker,
                     gefiltert auf Bilddateien - siehe OnAttachClick. -->
                <Button
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    Padding="10,6"
                    Background="Transparent"
                    BorderBrush="{StaticResource GlassEdgeHiBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusLarge}"
                    Click="OnAttachClick"
                    Content="📎"
                    ToolTipService.ToolTip="Bild anhängen" />

                <!-- Phase B: In-Chat-Diktat - einmaliges, blockierendes
                     Diktat für dieses Textfeld (siehe OnDictateClick), KEIN
                     Wake-Word-/Konversations-Loop. Text landet im Feld zum
                     Prüfen/Bearbeiten, wird NICHT automatisch gesendet. -->
                <Button
                    x:Name="DictateButton"
                    Grid.Column="3"
                    Margin="0,0,10,0"
                    Padding="10,6"
                    Background="Transparent"
                    BorderBrush="{StaticResource GlassEdgeHiBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusLarge}"
                    Click="OnDictateClick"
                    Content="🎙"
                    ToolTipService.ToolTip="Diktieren" />

                <TextBox
                    x:Name="ChatInput"
                    Grid.Column="4"
                    Margin="0,0,12,0"
                    Style="{StaticResource GlassTextBoxStyle}"
                    PlaceholderText="Nachricht eingeben... (Shift+Enter für neue Zeile)"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxHeight="120"
                    VerticalAlignment="Center"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    KeyDown="OnChatInputKeyDown" />

                <Button
                    x:Name="TraceToggleButton"
                    Grid.Column="5"
                    Margin="0,0,10,0"
                    Padding="10,6"
                    Background="Transparent"
                    BorderBrush="{StaticResource GlassEdgeHiBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusLarge}"
                    Click="OnTraceToggleClick"
                    Content="🧠"
                    ToolTipService.ToolTip="ThoughtStream ein-/ausblenden" />

                <Button
                    Grid.Column="6"
                    Style="{StaticResource GlassPrimaryButtonStyle}"
                    Click="OnSendClick"
                    Content="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToSendStopTextConverter}}" />
            </Grid>
        </Border>

    </Grid>
</Page>
