<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TARNO.UI.Pages.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TARNO.UI.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock Text="Memory" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Gespeicherte Fakten und Episoden aus TARNOs Langzeitgedächtnis." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Style="{StaticResource GlassTextBoxStyle}"
                PlaceholderText="Memory durchsuchen... (Enter zum Suchen)"
                KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource GlassSecondaryButtonStyle}" Content="Importieren" Click="OnImportClick" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource GlassCardStyle}">
                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Fakten" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.MemoryFacts, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemoryFactViewModel">
                                <StackPanel Spacing="2" Padding="0,6">
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{x:Bind Key}" FontWeight="SemiBold" />
                                        <Run Text=": " />
                                        <Run Text="{x:Bind Value}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{x:Bind Source}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind UpdatedAt}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource GlassCardStyle}">
                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Episoden" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.MemoryEpisodes, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemoryEpisodeViewModel">
                                <StackPanel Spacing="2" Padding="0,6">
                                    <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{x:Bind CreatedAt}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Tags}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
