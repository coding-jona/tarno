<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TARNO.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28" Spacing="6">
            <TextBlock Text="Einstellungen" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Konfiguration von TARNO." FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tabs: minimalistische Text-Navigation mit Indikator-Balken
                 statt Hintergrund-Fill (Lead-UX-Briefing 2026-07-14). -->
            <StackPanel Grid.Column="0" Spacing="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabGeneralIndicator" Grid.Column="0" Width="3" CornerRadius="2" Background="{StaticResource AccentGradientBrush}" Opacity="0" Margin="0,4" />
                    <Button
                        Grid.Column="1"
                        x:Name="TabGeneral"
                        Tag="General"
                        Click="OnTabClick"
                        Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" />
                            <TextBlock Text="Allgemein" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabVoiceIndicator" Grid.Column="0" Width="3" CornerRadius="2" Background="{StaticResource AccentGradientBrush}" Opacity="0" Margin="0,4" />
                    <Button
                        Grid.Column="1"
                        x:Name="TabVoice"
                        Tag="Voice"
                        Click="OnTabClick"
                        Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" />
                            <TextBlock Text="Voice" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabAiIndicator" Grid.Column="0" Width="3" CornerRadius="2" Background="{StaticResource AccentGradientBrush}" Opacity="0" Margin="0,4" />
                    <Button
                        Grid.Column="1"
                        x:Name="TabAi"
                        Tag="AI"
                        Click="OnTabClick"
                        Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE99A;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" />
                            <TextBlock Text="KI" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center">
                <Grid MaxWidth="820" HorizontalAlignment="Center">
                    <StackPanel x:Name="GeneralPanel" Spacing="20">
                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Erscheinungsbild" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Wähle das Farbschema der Anwendung." FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="ThemeCombo" Style="{StaticResource GlassComboBoxStyle}" SelectionChanged="OnThemeChanged" MinWidth="160" MaxWidth="320" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Dunkel" Tag="Dark" />
                                        <ComboBoxItem Content="Hell" Tag="Light" />
                                        <ComboBoxItem Content="System" Tag="System" />
                                    </ComboBox>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Startseite" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Seite, die beim Start angezeigt wird." FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="StartupPageCombo" Style="{StaticResource GlassComboBoxStyle}" SelectionChanged="OnStartupPageChanged" MinWidth="160" MaxWidth="320" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Dashboard" Tag="Home" />
                                        <ComboBoxItem Content="Voice" Tag="Voice" />
                                        <ComboBoxItem Content="Chat" Tag="Chat" />
                                    </ComboBox>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Autostart" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="TARNO mit Windows starten." FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="AutoStartSwitch" Style="{StaticResource GlassToggleSwitchStyle}" OnContent="An" OffContent="Aus" Toggled="OnAutoStartChanged" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />

                                <!-- Reaktiviert bereits vorhandene, aber nie ans XAML gebundene
                                     SettingsPage_Language*-Ressourcenstrings. Nutzt denselben
                                     MainViewModel.SetLanguageAsync-Aufruf wie die Sidebar-ComboBox
                                     in MainWindow (kein zweiter Codepfad) - inkl. desselben
                                     Neustart-Hinweises, da WinUI 3 unpackaged
                                     PrimaryLanguageOverride zur Laufzeit nicht neu setzen kann. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock x:Uid="SettingsPage_Language" Text="Sprache" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Uid="SettingsPage_LanguageDescription" Text="Sprache der Oberfläche und Spracherkennung." FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="LanguageCombo" Style="{StaticResource GlassComboBoxStyle}" SelectionChanged="OnLanguageChanged" MinWidth="160" MaxWidth="320" VerticalAlignment="Center">
                                        <ComboBoxItem x:Uid="SettingsPage_LanguageGerman" Content="Deutsch" Tag="de" />
                                        <ComboBoxItem x:Uid="SettingsPage_LanguageEnglish" Content="English" Tag="en" />
                                    </ComboBox>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="April-Fools-Modus" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Streik- und Burnout-Verhalten erzwingen (nächster Start)." FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="AprilFoolsSwitch" Style="{StaticResource GlassToggleSwitchStyle}" OnContent="An" OffContent="Aus" Toggled="OnAprilFoolsChanged" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource GlassPrimaryButtonStyle}" Content="Einstellungen speichern" Click="OnSaveSettingsClick" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Voice-Tab: minimale, aber echte Einstellung statt totem
                         Tab (Lead-UX-Briefing 2026-07-14) — Persistenz-Muster
                         1:1 wie AutoStartSwitch/OnAutoStartChanged. -->
                    <StackPanel x:Name="VoicePanel" Spacing="20" Visibility="Collapsed">
                        <Border Style="{StaticResource GlassCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Bestätigungston" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Akustisches Signal beim Erkennen des Wake-Words 'Hey Tarno'." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="WakeWordConfirmSwitch" Style="{StaticResource GlassToggleSwitchStyle}" OnContent="An" OffContent="Aus" Toggled="OnWakeWordConfirmChanged" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Mute-Hotkey" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Taste zum Stummschalten/Entstummen der Spracheingabe." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="MuteHotkeyCombo" Style="{StaticResource GlassComboBoxStyle}" SelectionChanged="OnMuteHotkeyChanged" MinWidth="200" MaxWidth="360" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Strg + Alt + M" Tag="Ctrl+Alt+M" />
                                    <ComboBoxItem Content="Strg + Alt + N" Tag="Ctrl+Alt+N" />
                                    <ComboBoxItem Content="Strg + Alt + B" Tag="Ctrl+Alt+B" />
                                    <ComboBoxItem Content="Deaktiviert" Tag="" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Phase B: Diktat-Eagerness - steuert nur das
                             In-Chat-Diktat-Mikrofon (Chat-Seite), NICHT den
                             normalen Wake-Word-Sprachmodus (dort bleibt
                             schnelle Antwortzeit wichtig). -->
                        <Border Style="{StaticResource GlassCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Diktat-Geduld" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Wie lange das Chat-Diktat-Mikrofon auf eine Sprechpause wartet, bevor es beendet." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="DictateEagernessCombo" Style="{StaticResource GlassComboBoxStyle}" SelectionChanged="OnDictateEagernessChanged" MinWidth="160" MaxWidth="320" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Geduldig (12s)" Tag="low" />
                                    <ComboBoxItem Content="Normal (9s)" Tag="medium" />
                                    <ComboBoxItem Content="Zügig (5s)" Tag="high" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Echte Mikrofon-/Lautsprecher-Geraeteauswahl (ersetzt das
                             urspruenglich angefragte "Windows 10/11"-Konzept - recherchiert
                             und verworfen, siehe Plan: beide OS-Versionen nutzen denselben
                             WASAPI/MME-Stack, es gibt keinen OS-versionsabhaengigen
                             Erkennungsunterschied. Stattdessen echte, vom Backend
                             enumerierte Geraetelisten, inkl. eingebauter Array-Mikrofone.) -->
                        <Border Style="{StaticResource GlassCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Mikrofon" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Eingabegerät für Wake-Word-Erkennung und Sprachbefehle (inkl. eingebauter Mikrofone)." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="MicrophoneDeviceCombo" Style="{StaticResource GlassComboBoxStyle}" SelectionChanged="OnMicrophoneDeviceChanged" MinWidth="220" MaxWidth="360" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Lautsprecher" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Ausgabegerät für TARNOs Sprachausgabe." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="SpeakerDeviceCombo" Style="{StaticResource GlassComboBoxStyle}" SelectionChanged="OnSpeakerDeviceChanged" MinWidth="220" MaxWidth="360" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource GlassPrimaryButtonStyle}" Content="Einstellungen speichern" Click="OnSaveSettingsClick" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- KI-Tab: API-Key-Verwaltung ueber SecretsVault (Python-Backend via gRPC) -->
                    <StackPanel x:Name="AiPanel" Spacing="20" Visibility="Collapsed">
                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="6" Margin="0,0,0,8">
                                <TextBlock Text="API-Keys" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Keys werden verschlüsselt im Windows Credential Manager gespeichert, niemals in einer Datei." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel x:Name="ApiKeyRowsPanel" Spacing="20" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
