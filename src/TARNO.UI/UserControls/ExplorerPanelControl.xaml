<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TARNO.UI.UserControls.ExplorerPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 1:1 aus CodeWorkspacePage.xaml uebernommen (Multi-Screen-Plan Phase 1) -
         reiner Verschieb, damit dasselbe Panel sowohl inline im Hauptfenster
         (Einzelbildschirm) als auch in einem eigenen ExplorerWindow auf einem
         zweiten Bildschirm gehostet werden kann. -->
    <Grid Background="{StaticResource MainCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            x:Name="PanelHeader"
            Grid.Row="0"
            Height="40"
            Background="{StaticResource MainCanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            CanDrag="True"
            DragStarting="OnPanelDragStarting">
            <TextBlock
                Text="Explorer"
                VerticalAlignment="Center"
                Margin="16,0"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}" />
        </Border>
        <TreeView
            x:Name="ExplorerTree"
            Grid.Row="1"
            ItemInvoked="OnTreeItemInvoked"
            Expanding="OnTreeExpanding"
            Collapsed="OnTreeCollapsed"
            Margin="8,0,0,0">
            <TreeView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Text="{Binding IconGlyph}"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Zum Kontext hinzufügen" Click="OnAddToContextClick" />
                    <MenuFlyoutItem Text="Im Explorer öffnen" Click="OnOpenInFileExplorerClick" />
                    <MenuFlyoutItem Text="Pfad kopieren" Click="OnCopyPathClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Ordner hinzufügen" Click="OnAddFolderToWorkspaceClick" />
                    <MenuFlyoutItem Text="Root entfernen" Click="OnRemoveRootClick" />
                </MenuFlyout>
            </TreeView.ContextFlyout>
        </TreeView>
        <TextBox
            x:Name="FileContentView"
            Grid.Row="2"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="NoWrap"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            FontSize="11"
            PlaceholderText="Dateiinhalt"
            Background="{StaticResource MainCanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}" />
    </Grid>
</UserControl>
