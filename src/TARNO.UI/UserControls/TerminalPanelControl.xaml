<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TARNO.UI.UserControls.TerminalPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="TerminalRoot" Background="{StaticResource MainCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            x:Name="PanelHeader"
            Grid.Row="0"
            Height="32"
            Background="{StaticResource MainCanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            CanDrag="True"
            DragStarting="OnPanelDragStarting"
            DoubleTapped="OnPanelHeaderDoubleTapped">
            <Grid>
                <TextBlock
                    Text="Terminal"
                    VerticalAlignment="Center"
                    Margin="12,0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}" />
                <Button
                    x:Name="TerminalToggleButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Padding="6,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnTerminalPanelToggleClick"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Content="▼" />
            </Grid>
        </Border>
        <Grid
            x:Name="TerminalContent"
            x:FieldModifier="public"
            Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="TerminalOutput"
                Grid.Row="0"
                ItemsSource="{x:Bind Terminal.OutputLines, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <TextBox
                x:Name="TerminalInput"
                Grid.Row="1"
                PlaceholderText="Befehl eingeben..."
                KeyDown="OnTerminalInputKeyDown"
                FontFamily="Consolas"
                FontSize="12"
                Background="Transparent"
                BorderBrush="{StaticResource BorderBrush}" />
        </Grid>
    </Grid>
</UserControl>
