<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TARNO.UI.UserControls.ContextDockPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource MainCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="PanelHeader"
            Grid.Row="0"
            Height="40"
            Background="{StaticResource MainCanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            CanDrag="True"
            DragStarting="OnPanelDragStarting">
            <TextBlock
                Text="Kontext"
                VerticalAlignment="Center"
                Margin="16,0"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12" Spacing="12">
                <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Markierte Dateien" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <ListView
                            ItemsSource="{x:Bind ViewModel.SelectedContextFiles, Mode=OneWay}"
                            MaxHeight="160"
                            BorderThickness="0"
                            Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Kontext leeren" HorizontalAlignment="Stretch" Click="OnClearContextClick" Style="{StaticResource GlassSecondaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Quick Actions" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button Content="Build" Style="{StaticResource GlassSecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button Content="Testen" Style="{StaticResource GlassSecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button Content="Git-Status" Style="{StaticResource GlassSecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button Content="Befehlspalette" Click="OnCommandPaletteClick" Style="{StaticResource GlassSecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Provider / Modell" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveProviderModelLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Agent-Status" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Bereit" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
