<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TARNO.UI.Dialogs.ChatSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TARNO.UI.ViewModels"
    mc:Ignorable="d"
    Title="Einstellungen"
    CloseButtonText="Schließen"
    DefaultButton="Close"
    Width="1200"
    Height="820"
    Background="{StaticResource BackgroundCardBrush}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- WinUI's DefaultContentDialogStyle deckelt die tatsaechliche
         Render-Breite hart ueber das ThemeResource "ContentDialogMaxWidth"
         (Standard ~548px) - das eigene Width="1200" oben wird von der
         Vorlage ignoriert, solange dieses Resource nicht lokal ueberschrieben
         wird. Ohne diese Ueberschreibung bleibt der Dialog immer bei ~548px
         geklemmt, egal wie breit Width gesetzt ist (live bestaetigter Bug -
         jeder Inhalt wurde exakt an dieser Breite abgeschnitten). -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
    </ContentDialog.Resources>

    <Grid Width="1150" Height="680">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView
            x:Name="CategoryList"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            SelectionMode="Single"
            SelectionChanged="OnCategorySelectionChanged">
            <ListViewItem Content="💪 Modell" IsSelected="True" />
            <ListViewItem Content="🗜️ Kontext-Effizienz" />
            <ListViewItem Content="👥 Agent-Pool" />
        </ListView>

        <ScrollViewer
            Grid.Column="1"
            Margin="24,0,0,0"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Stretch">

        <!-- Panel: Modell (Starkes Modell) -->
        <StackPanel
            x:Name="ModelPanel"
            HorizontalAlignment="Stretch"
            Spacing="12"
            Visibility="Visible">
            <TextBlock Text="Modell" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock
                Text="Starkes Modell (mistral-medium-2508): höhere Qualität bei komplexen Anfragen — deutlich langsamer (~0,38 Anfragen/Sekunde) und höherer Tokenverbrauch. Nur bei Mistral wirksam."
                TextWrapping="Wrap"
                MaxWidth="860"
                HorizontalAlignment="Left"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}" />
            <Button
                Padding="10,6"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                Click="OnHighTierToggleClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="💪" FontSize="12" />
                    <TextBlock
                        Text="{x:Bind ViewModel.HighTierModelEnabled, Mode=OneWay, Converter={StaticResource BoolToOnOffLabelConverter}, ConverterParameter='Starkes Modell'}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Panel: Kontext-Effizienz -->
        <StackPanel
            x:Name="ContextEfficiencyPanel"
            HorizontalAlignment="Stretch"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock Text="Kontext-Effizienz (Beta)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock
                Text="Reduziert Tool-Ausgaben und fasst alten Verlauf automatisch zusammen, um Nutzungslimits zu schonen."
                TextWrapping="Wrap"
                MaxWidth="860"
                HorizontalAlignment="Left"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}" />
            <Button
                Padding="10,6"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderBrush="{StaticResource GlassEdgeHiBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusLarge}"
                Click="OnContextEfficiencyToggleClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🗜️" FontSize="12" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ContextEfficiencyEnabled, Mode=OneWay, Converter={StaticResource BoolToOnOffLabelConverter}, ConverterParameter='Kontext-Effizienz'}"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Panel: Agent-Pool - reine Konfiguration (Auswahl der Agenten).
             Starten/Beobachten passiert im Chat: Chat-Header →
             👥 Agent-Pool-Modus (dieselbe Eingabezeile wie Einzel-Agent). -->
        <StackPanel
            x:Name="AgentPoolPanel"
            Width="860"
            HorizontalAlignment="Left"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock Text="Agent-Pool: Agenten wählen (2-4, einer als Lead)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock
                Text="Aufgabe wird im Chat gestartet: Chat-Header → 👥 Agent-Pool."
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}" />

            <ListView ItemsSource="{x:Bind ViewModel.PoolAgentCatalog}" Height="220" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PoolAgentSelectionItem">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center" FontSize="12" />
                            <CheckBox Grid.Column="2" Content="Lead" IsChecked="{x:Bind IsLead, Mode=TwoWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        </Grid>
        </ScrollViewer>
    </Grid>
</ContentDialog>
