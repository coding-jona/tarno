<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TARNO.UI.Dialogs.ProviderLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    Title="API-Key anlegen"
    PrimaryButtonText="Schließen"
    Background="{StaticResource BackgroundCardBrush}"
    Style="{StaticResource DefaultContentDialogStyle}"
    MaxWidth="1000"
    MaxHeight="850">

    <!-- WinUI klemmt die tatsaechliche Render-Groesse eines ContentDialog
         hart auf das ThemeResource "ContentDialogMaxWidth"/"ContentDialogMaxHeight"
         (Standard ~548px) - MaxWidth/MaxHeight oben am ContentDialog selbst
         wird ohne diese lokale Ueberschreibung ignoriert (live bestaetigter
         Bug, siehe ChatSettingsDialog.xaml). -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">850</x:Double>
    </ContentDialog.Resources>

    <Grid RowDefinitions="Auto, *, Auto, Auto" MaxWidth="960" MaxHeight="800">
        <TextBlock
            x:Name="InstructionsText"
            Grid.Row="0"
            FontSize="13"
            Foreground="{StaticResource TextSecondaryBrush}"
            TextWrapping="Wrap"
            Margin="0,0,0,10" />

        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <WebView2
                x:Name="ProviderWebView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MinHeight="400" />
        </Border>

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{StaticResource TextMutedBrush}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ErrorText"
                FontSize="12"
                Foreground="{StaticResource ErrorBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="10"
            HorizontalAlignment="Right"
            Margin="0,10,0,0">
            <Button
                x:Name="PasteButton"
                Content="Aus Zwischenablage einfügen"
                Click="OnPasteFromClipboardClick"
                Style="{StaticResource GlassSecondaryButtonStyle}" />
            <Button
                Content="Manuell eingeben"
                Click="OnManualClick"
                Style="{StaticResource GlassSecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</ContentDialog>
