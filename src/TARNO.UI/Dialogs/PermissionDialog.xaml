<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TARNO.UI.Dialogs.PermissionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root"
    Title="Aktion bestätigen"
    PrimaryButtonText="Ausführen"
    CloseButtonText="Ablehnen"
    DefaultButton="Close"
    Background="{StaticResource BackgroundCardBrush}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="14" MaxWidth="440">
        <Border x:Name="RiskBadge" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left">
            <TextBlock x:Name="RiskBadgeText" FontSize="12" FontWeight="SemiBold" />
        </Border>

        <TextBlock
            Text="TARNO möchte folgende Aktion ausführen:"
            FontSize="13"
            Foreground="{StaticResource TextSecondaryBrush}" />

        <Border Style="{StaticResource GlassCardStyle}" Padding="10">
            <TextBlock
                x:Name="TargetText"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{StaticResource TextPrimaryBrush}"
                TextWrapping="Wrap" />
        </Border>

        <StackPanel x:Name="SafetyPhrasePanel" Spacing="6" Visibility="Collapsed">
            <TextBlock
                x:Name="SafetyPhraseHint"
                FontSize="12"
                Foreground="{StaticResource ErrorBrush}"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="SafetyPhraseBox"
                Style="{StaticResource GlassTextBoxStyle}"
                PlaceholderText="Sicherheitsphrase eingeben..."
                TextChanged="OnSafetyPhraseChanged" />
        </StackPanel>

        <CheckBox
            x:Name="PersistentCheckBox"
            Content="Für diese Sitzung merken (nicht erneut fragen)" />
    </StackPanel>
</ContentDialog>
